            aux = [nome,sexo,celular,email,idade]
            dados.append(aux)
            print("CADASTRO REALIZADO COM SUCESSO")
            
            continuar = input("DEJESA REALIZAR OUTRO CADASTRO?  <S/N>")

    elif escolha == 2:
        pos=0
        tam=len(dados)
        print("\n---CONSULTAR CADASTRO---")
        while(pos<tam):
            aux=dados[pos]
            nome=aux[0]
