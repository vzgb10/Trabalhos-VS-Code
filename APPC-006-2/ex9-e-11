pacientes = []

quant = int(input("QUANTOS PACIENTES VOCÊ QUER CADASTRAR? "))
print("*" *50)
for x in range(1, quant+1):
    nome     = input("NOME DO PACIENTE:        ").upper()
    print("---------------------------------------")
    sintoma1 = input("PRIMEIRO SINTOMA:        ").upper()
    print("---------------------------------------")
    sintoma2 = input("SEGUNDO SINTOMA:         ").upper()
    print("---------------------------------------")
    sintoma3 = input("TERCEIRO SINTOMA:        ").upper()
    print("---------------------------------------")
    idade    = input("IDADE DO PACIENTE:       ")

    paciente = [x, nome, sintoma1, sintoma2, sintoma3, idade]
    pacientes.append(paciente)

for x, aux in enumerate(pacientes):
    x        = aux[0]
    nome     = aux[1]
    sintoma1 = aux[2]
    sintoma2 = aux[3]
    sintoma3 = aux[4]
    idade    = aux[5]
    print(f"\n  PACIENTE {x}")
    print(f"NOME:      {nome}      ")
    print(f"SINTOMA 1: {sintoma1}  ")
    print(f"SINTOMA 2: {sintoma2}  ")
    print(f"SINTOMA 3: {sintoma3}  ")
    print(f"IDADE:     {idade} anos")
    print("-" * 45)

soma_idades = 0
for aux in pacientes:
    soma_idades += aux[1]
media = soma_idades / quant
print("*" *50)
print(f"IDADE MÉDIA: {media:.1}")

for aux in pacientes:
    nome     = aux[1]
    sintoma1 = aux[2]
    sintoma2 = aux[3]
    sintoma3 = aux[4]
    print(f"\nPACIENTE: {nome}")
    print(f"PRIMEIRO SINTOMA: {sintoma1}")
    print(f"SEGUNDO SINTOMA:  {sintoma2}")
    print(f"TERCEIRO SINTOMA: {sintoma3}")

sintomas = []
for aux in pacientes:
    for sintoma in [aux[2], aux[3], aux[4]]:
        if sintoma not in sintomas:
            sintomas.append(sintoma)
sintomas.sort()

for sintoma in sintomas:
    ocorrencias = 0
    for aux in pacientes:
        for s in [aux[2], aux[3], aux[4]]:
            if s == sintoma:
                ocorrencias += 1
    print(f"{sintoma}: {ocorrencias} ocorrências")