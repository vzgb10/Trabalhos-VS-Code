# CALCULAR A NOTA FINAL

n1 = float(input("Digite a nota da prova 1: "))
p1 = float(input("Digite o peso da prova 1: "))
n2 = float(input("Digite a nota da prova 2: "))
p2 = float(input("Digite o peso da prova 2: "))

media=(n1*p1+n2*p2)/(p1+p2)

print("***************************************************************")
print(f"Nota 1: {n1:.1f}")
print(f"Peso 1: {p1:.1f}")
print(f"Nota 2: {n2:.1f}")
print(f"Peso 2: {p2:.1f}")
print(f"Média Final: {media:.1f}")
print("***************************************************************")
print("Situação Final: ")

if media<5:
    print("REPROVADO")
elif media>=5 and media<8:
    print("APROVADO")
elif media>=8 and media<9:
    print("APROVADO. PARABÉNS PELO DESEMPENHO!")
else:
    print("PARABÉNS. VOCÊ FOI APROVADO COM LOUVOR!")