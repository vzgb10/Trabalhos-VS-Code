                print(idade)
            else:
                print("NÃO FOI POSSÍVEL ENCONTRAR ESSA OPÇÃO")

            pos+=1


    elif escolha == 3:
        print("\n---LISTAR CONTATOS---")
        pos = 0
        tam = len(dados)
        while(pos<tam):
            aux=dados[pos]
            nome=aux[0]
            sexo=aux[1]
