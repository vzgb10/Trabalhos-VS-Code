#listar dados
#calcular média
#calcular desconto mensalidade

dados = [
         ["800games", 3000, 9, 4  ],
         ["hyzzaaquy", 4000, 7, 8 ],
         ["adamazthor", 3500, 2, 4],
         ["syr lucas", 4500, 6, 5 ],
         ["sandowau", 300, 7, 4   ]
]

pos = 0
tam = len(dados)
desconto = 0
descmens = 0

while(pos<tam):
    nome = dados[pos][0]
    mensalidade = dados[pos][1]
    n1 = dados[pos][2]
    n2 = dados[pos][3]
    media = (n1 + n2) / 2
    if media<5:
        desconto = 0.0
    elif 5<=media<7:
        desconto = 0.07
    elif 7<=media<9:
        desconto = 0.1
    else:
        desconto = 0.25
    descmens = mensalidade * desconto
    print(nome,"\t",mensalidade,"\t",n1,"\t",n2,"\t", "MÉDIA: ",media,"\t", "DESCONTO: ",desconto,"\t", "MENSALIDADE COM DESCONTO: ",descmens)
    pos+=1
